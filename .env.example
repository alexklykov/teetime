# Copy to .env.local for local development. Keep real credentials out of Git.
# Vercel: pooled Neon connection string, available to server code only.
DATABASE_URL=
# Prisma migrations and GitHub Actions: direct Neon connection string.
DATABASE_URL_UNPOOLED=
# GitHub Actions secrets for Lake Padden's booking-site login.
LAKEPADDEN_EMAIL=
LAKEPADDEN_PASSWORD=
